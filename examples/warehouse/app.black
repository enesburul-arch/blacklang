entity Product {
  tenantId text required default "default"
  sku text required unique length 3..40
  name text required label "Product Name" placeholder "Enter product name" help "Visible product name in lists and orders" ui text text 14 semibold left
  photo image optional accept "image/*" label "Product Photo" help "Product image selected from the local form is stored as a data URL"
  stock number default 0 min 0 label "Stock Count" placeholder "Enter stock count" help "Current available quantity"
  price money min 0 label "Unit Price" placeholder "Enter unit price" help "Selling price for one unit"
  computed inventoryValue money = stock * price label "Inventory Value"
  policy tenant tenantId
  index tenantId, stock
  index stock
}

migration RenameWarehouseProduct {
  rename entity WarehouseProduct to Product
  rename field Product.quantity to stock
}

entity Customer {
  tenantId text required default "default"
  name text required label "Customer Name" placeholder "Enter customer name" help "Main display name for the customer"
  email email unique label "Email Address" placeholder "name@example.com" help "Used as the unique customer contact"
  phone text optional label "Phone Number" placeholder "Enter phone number" help "Optional direct contact number"
  policy tenant tenantId
  index tenantId
}

entity Order {
  tenantId text required default "default"
  ownerId text required default "system"
  customer Customer required load list detail query mutation label "Customer" placeholder "Select a customer" help "Customer connected to this order"
  total money default 0 min 0 label "Order Total" placeholder "Enter order total" help "Total amount for this order"
  discount money default 0 min 0 label "Discount" placeholder "Enter discount" help "Discount cannot exceed the order total"
  status text default draft label "Order Status" placeholder "Enter order status" help "Workflow status such as draft or shipped"
  trackingNumber text optional label "Tracking Number" placeholder "Enter tracking number" help "Required after shipping"
  policy tenant tenantId
  policy owner ownerId
  index tenantId, status
  index customer, status
  validate discount <= total message "Discount cannot exceed total"
  validate trackingNumber required when status == shipped message "Tracking number is required when shipped"
}

seed DemoProducts {
  source Product

  row DemoProductLow {
    tenantId "default"
    sku "LOW-001"
    name "Low Stock Widget"
    stock 3
    price 19.99
  }

  row DemoProductFull {
    tenantId "default"
    sku "FULL-001"
    name "Packed Shelf Widget"
    stock 42
    price 24.50
  }
}

seed DemoCustomers {
  source Customer

  row DemoCustomerAcme {
    tenantId "default"
    name "Acme Logistics"
    email "ops@acme.example"
    phone "+1-555-0100"
  }
}

seed DemoOrders {
  source Order

  row DemoOrderDraft {
    tenantId "default"
    ownerId "system"
    customer ref DemoCustomerAcme
    total 320.50
    discount 20.50
    status "draft"
  }
}

test WarehouseBrowserSmoke {
  page Products
  expect text "Depo"
  expect page LowStock
  expect action RestockProduct
}

query LowStockProducts {
  source Product
  where stock < 10
  aggregate lowStockCount count
  aggregate totalStock sum stock
  aggregate averagePrice avg price
  sort stock asc
  limit 50
}

job LowStockMonitor {
  schedule every 15 minutes
  run query LowStockProducts
}

action RestockProduct {
  source Product
  input quantity number required min 1 label "Quantity" placeholder "Enter received quantity" help "Amount added to current stock"
  value restockValue = quantity
  if restockValue > 0 and stock >= 0
    set stock = stock + restockValue
  else
    set stock = stock
  allow Admin, Worker
  success "Stock updated"
}

role Admin {
  allow all
}

role Worker {
  allow read Product
  deny read Product price
  allow update Product stock
  allow read Customer
  allow read Order
  allow update Order status
}

api LowStockReport {
  method GET
  path "/api/reports/low-stock/{warehouseId}"
  param warehouseId text
  query limit integer
  private
}

api StockWebhook {
  method POST
  path "/api/webhooks/stock"
  body tenantId text required
  body sku text required
  body stock number required min 0

  update Product where sku == body.sku {
    value incomingStock = body.stock
    if incomingStock >= 0 and tenantId == body.tenantId
      set stock = incomingStock
    else
      set stock = stock
  }
  respond accepted
  webhook
  public
}

transaction RestockAtomic {
  action RestockProduct
  api StockWebhook
}

service InventoryIntegration {
  api StockWebhook
}

workflow OrderPreparation {
  source Order
  states draft, picking, verified, packaged, shipped

  transition startPicking {
    from draft
    to picking
    allow Admin, Worker
  }

  transition ship {
    from packaged
    to shipped
    allow Admin
  }
}

state OrdersPageState {
  selectedOrders Order[]
  activeFilter text
  modal createOrder closed
}

component StockBadge {
  input stock number
  variant low when stock < 10
  variant normal when stock >= 10
}

layout AdminLayout {
  sidebar {
    item Products
    item LowStock
    item Customers
    item Orders
  }
}

page Products {
  layout AdminLayout
  source Product
  access Admin, Worker

  view {
    order table, StockSummary, StockCards, detail, form
    compose tabs gap md
    section StockSummary component StockBadge bind selected span 1 title "Stock Summary"
    section StockCards component StockBadge bind each span 1 title "Stock Cards"
    tab List sections table
    tab Record sections StockSummary, StockCards, detail, form
    trigger detail on rowSelect
    trigger form on createStart
    trigger form on editStart
    trigger detail on saveSuccess
    trigger table on close
  }

  table {
    id ProductsTable
    class inventoryTable
    columns sku, name, photo, stock, price, inventoryValue
    search sku, name
    filter stock
    sort stock desc
    paginate 10
    ui table border 1 solid compact true
  }

  form {
    id ProductForm
    class inventoryForm
    fields sku, name, photo, stock, price
    ui box border 1 solid 12 12 12 12 8 left | button primary white 6 md solid
  }
  actions create, edit, delete, archive, restore, RestockProduct
  action create id CreateProductButton
  action create class primaryAction
  action create ui button primary white 6 md solid
  action delete id DeleteProductButton
  action delete class dangerAction
  action delete ui button danger white 6 sm solid
}

page LowStock {
  layout AdminLayout
  source Product
  query LowStockProducts
  access Admin, Worker

  table {
    columns sku, name, photo, stock, price, inventoryValue
    search sku, name
    paginate 10
  }
  actions RestockProduct
}

page Customers {
  layout AdminLayout
  source Customer
  access Admin, Worker

  view {
    order table, detail, form
    compose grid columns 2 gap md stackAt md
    section table span 1
    group CustomerWorkspace sections detail, form compose stack gap md span 1 title "Customer Workspace"
  }

  table {
    columns name, email, phone
    search name, email
    filter email
    sort name asc
    paginate 10
  }

  form {
    fields name, email, phone
  }
  actions create, edit, delete, archive, restore
}

page Orders {
  layout AdminLayout
  source Order
  access Admin, Worker

  view {
    order table, detail, form
    compose grid columns 2 gap md stackAt md
    section table span 2
    section detail display drawer side right title "Order Details"
    section form display modal title "Order Form"
    trigger detail on rowSelect
    trigger form on createStart
    trigger form on editStart
    trigger detail on saveSuccess
    trigger table on close
  }

  table {
    columns customer, total, discount, status, trackingNumber
    search customer, status, trackingNumber
    filter customer, status
    sort customer asc
    paginate 10
  }

  form {
    fields customer, total, discount, status, trackingNumber
  }
  actions create, edit, delete, archive, restore
}
